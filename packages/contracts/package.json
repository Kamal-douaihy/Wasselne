{
  "name": "@wasselne/contracts",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript ../../docs/phase-2/openapi.yaml -o src/generated/openapi-types.ts",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run generate",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no runtime logic to unit test yet (generated types only)\""
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "openapi-typescript": "^7.5.2",
    "typescript": "^5.7.3"
  }
}
