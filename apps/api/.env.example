NODE_ENV=development
API_PORT=3000

DATABASE_URL=postgres://wasselne:wasselne_local@localhost:5432/wasselne
REDIS_URL=redis://localhost:6379

# Generate real secrets with `openssl rand -hex 32`; never commit real values.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-to-32-bytes-min
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_S=30
OTP_REQUEST_LIMIT_PER_PHONE_PER_HOUR=5
OTP_REQUEST_LIMIT_PER_IP_PER_HOUR=20
OTP_VERIFY_LIMIT_PER_IP_PER_HOUR=30
GLOBAL_LIMIT_PER_IP_PER_MINUTE=300
NEEDS_PROFILE_TTL_S=600

# Reverse-proxy hops to trust for X-Forwarded-For (0 = none). Per-IP limits depend on this.
TRUST_PROXY_HOPS=0
REDIS_KEY_PREFIX=wsl:

# dev = OTP code is written to Redis (key <prefix>dev:sms:<challenge_id>) for local tools; the API
#       never returns it. Refused in production.
# disabled = OTP requests answer 503 until a real SMS provider is selected and wired.
SMS_ADAPTER=dev
