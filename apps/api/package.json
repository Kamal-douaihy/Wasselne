{
  "name": "@wasselne/api",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev:api": "tsx watch src/main.api.ts",
    "dev:worker": "tsx watch src/main.worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --runInBand",
    "test:e2e": "jest -c jest.e2e.config.js --runInBand",
    "db:check-schema": "tsx src/db/check-schema.ts",
    "admin:create": "tsx src/db/create-admin.ts",
    "e2e:admin-console": "tsx scripts/admin-console-e2e.ts",
    "e2e:dart-client": "tsx scripts/dart-client-live.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^18.0.3",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.4",
    "nestjs-pino": "^4.2.0",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "yaml": "^2.6.1"
  }
}
